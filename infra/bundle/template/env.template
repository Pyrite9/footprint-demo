# 발자국 실행 묶음의 설정입니다. start 스크립트가 처음 켤 때 이 파일을 복사해 .env를 만들고, 비어 있는 비밀값 세 줄을 무작위 값으로 채웁니다.
# .env에는 비밀값이 들어 있습니다. 다른 사람에게 보내거나 공유 폴더·USB에 남기지 마세요.
# .env를 지우면 다음 start가 새 비밀값을 만듭니다. 이미 만든 데이터베이스는 처음 비밀번호를 기억해서 새 값으로는 열리지 않습니다.
# 그래서 데이터가 있는데 .env가 없으면 start가 멈춥니다. .env를 되살리거나 reset으로 데이터를 지운 뒤 켜세요.

# 실행 방식입니다. demo 또는 prod를 적습니다. 처음 켜기 전에 정하세요. 바꾸려면 reset으로 데이터를 지운 뒤 켭니다.
#   demo: 시연용. 시작 계정 11명과 데모 과제가 들어가고, 시작 계정의 이메일·비밀번호로 로그인합니다. 인터넷이 없어도 됩니다.
#   prod: 운영 설정. 시작 데이터가 없고 학교 구글 계정으로만 로그인합니다. 인터넷과 아래 PROFESSOR_EMAILS가 필요합니다.
FOOTPRINT_MODE=demo

# 구글 로그인할 때 교수로 저장할 학교 이메일입니다. 여러 개면 쉼표로 구분합니다. prod에서는 비울 수 없습니다.
PROFESSOR_EMAILS=

# 비밀값입니다. 비워 두면 start가 처음 켤 때 무작위 값으로 채웁니다. 직접 적지 않아도 됩니다.
JWT_SECRET=
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
