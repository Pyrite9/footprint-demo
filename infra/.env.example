POSTGRES_DB=footprint
POSTGRES_USER=footprint
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
MINIO_ROOT_USER=footprint
MINIO_ROOT_PASSWORD=change-me-please
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# 산출물 파일을 담는 MinIO 버킷 이름입니다. 비워 두면 footprint입니다. 조원은 그대로 주석으로 둡니다.
# 맨 위 docker-compose.yml로 켠 백엔드와 백업 스크립트(infra/backup)가 이 파일에서 읽습니다. bootRun으로 켠 백엔드는 이 파일을 읽지 않으므로, 바꿨다면 같은 값을 환경 변수로 줍니다.
# STORAGE_BUCKET=footprint
# 구글 로그인할 때 교수로 저장하거나 교수로 올릴 이메일입니다. 쉼표로 구분합니다. 실제 이메일은 복사한 infra/.env에만 적습니다.
PROFESSOR_EMAILS=

# 운영 설정(O-2). 비워 두면 개발 설정입니다. 조원은 아래 줄을 그대로 주석으로 둡니다.
# 운영 설정으로 켤 때는 맨 앞의 #을 지우고 값을 넣습니다. 위의 POSTGRES_PASSWORD, MINIO_ROOT_PASSWORD도 공개된 기본값(change-me...)에서 바꿔야 하고
# PROFESSOR_EMAILS도 비울 수 없습니다. 하나라도 남아 있으면 백엔드가 켜지지 않고 로그에 바꿀 이름만 나옵니다.
# 이미 만든 DB·MinIO volume의 비밀번호는 이 파일을 바꿔도 바뀌지 않습니다. 운영 비밀번호는 새 volume을 만들 때 넣습니다.
# SPRING_PROFILES_ACTIVE=prod
# JWT 서명 키. 영문 32자 이상의 무작위 값입니다.
# JWT_SECRET=
# 백엔드를 부를 수 있는 화면 주소. 여러 개면 쉼표로 구분합니다. 기본값은 http://localhost:5173 입니다.
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# 화면의 이메일·비밀번호 로그인 폼. 운영 설정이면 false입니다(맨 위 docker-compose.yml 주석 참고).
# VITE_PASSWORD_LOGIN=false
