{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(./gradlew build *)",
      "Bash(./gradlew test *)",
      "Bash(./gradlew bootRun *)",
      "Bash(gradlew.bat build *)",
      "Bash(gradlew.bat test *)",
      "Bash(gradlew.bat bootRun *)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run dev)",
      "Bash(npm run mock)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose up *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git remote *)",
      "Bash(gh *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(docker compose down *)",
      "Edit(./backend/build.gradle)",
      "Edit(./frontend/package.json)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)"
    ]
  }
}
