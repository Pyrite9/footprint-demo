# Node
node_modules/
dist/

# Java
build/
target/
out/
.gradle/

# IDE
.idea/
*.iml
.vscode/*
!.vscode/extensions.json

# 환경 변수 (예시 파일과 화면 기본 설정만 올린다)
.env*
!.env.example
!frontend/.env

# Claude Code 개인 설정
.claude/settings.local.json

# OS, 로그
.DS_Store
Thumbs.db
*.log

# 가짜 API에 올린 산출물 파일 (시작 파일 seed-*만 올린다)
frontend/mock/files/*
!frontend/mock/files/seed-*

# 백업 묶음 (O-4). 개인정보(이름, 이메일, 평가 점수·의견, 올린 파일)가 들어 있어서 절대 올리지 않는다
infra/backup/bundles/

# 제출용 실행 묶음 결과 폴더 (O-3). 이미지 tar가 들어 있어 크고, 만들 때마다 새로 생김
infra/bundle/out/

# 제출용 실행 묶음에 넣을 mkcert 실행 파일을 받아 두는 곳 (배포-2). 만들 때마다 다시 받지 않으려고 둠
infra/bundle/cache/

# branch 사이트의 start 스크립트가 main, dev branch에서 꺼낸 코드 (배포-3). 켤 때마다 새로 꺼냄
infra/sites/src/

# branch 사이트의 https 인증서와 개인 key (배포-3). 이 PC에서 만든 것이라 절대 올리지 않는다
infra/sites/certs/
